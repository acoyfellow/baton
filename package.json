    "t4": "bun evals/t4-e2e.ts",
    "t5": "bun evals/t5-safety.ts",
    "evals": "bun evals/run-all.ts",
    "report": "bun evals/report.ts",
    "smoke": "bun evals/smoke.ts",
    "bench": "DO_REPEATS=${DO_REPEATS:-3} DO_ARMS=${DO_ARMS:-vision:kimi-k2.6,vision:qwen3.8-27b,baton:kimi-k2.6,pilot} DO_SKIP_CACHE=${DO_SKIP_CACHE:-1} bun evals/run-all.ts",
    "bench:mock": "DO_MOCK=1 DO_RUN=reference DO_SCREENS=2 DO_PER_SCREEN=2 DO_T3_PER_SCREEN=1 DO_TASKS=mail-archive DO_REPEATS=2 DO_ARMS=vision:kimi-k2.6,vision:qwen3.8-27b,baton:kimi-k2.6,pilot bun evals/run-all.ts",
